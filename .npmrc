# Strict dependency resolution
strict-peer-dependencies=true
auto-install-peers=false

# Workspace settings
link-workspace-packages=true
shared-workspace-lockfile=true

# Controlled hoisting for monorepo
# Hoist specific packages needed by transpiled workspace packages
public-hoist-pattern[]=*@tanstack/react-query*
public-hoist-pattern[]=*framer-motion*
public-hoist-pattern[]=*lucide-react*
public-hoist-pattern[]=*react-icons*
public-hoist-pattern[]=*react-intersection-observer*

# Performance
store-dir=~/.pnpm-store
