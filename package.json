{
  "name": "my-website-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "check": "turbo run check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "verify:deps": "bash scripts/verify-dependencies.sh",
    "postinstall": "bash scripts/verify-dependencies.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^20",
    "eslint-plugin-turbo": "^2.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.1",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.0.0",
      "@types/react-dom": "19.0.0",
      "@tanstack/react-query": "5.84.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19.2.3",
        "react-dom": "19.2.3"
      }
    }
  }
}
