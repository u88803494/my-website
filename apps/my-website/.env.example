# =============================================================================
# Environment variables for local development
#
# Copy this file to .env.local and fill in the values:
#   cp apps/my-website/.env.example apps/my-website/.env.local
#
# Schema is defined and validated in src/env.ts (@t3-oss/env-nextjs).
# Empty strings are treated as undefined, so optional keys may be left blank.
#
# NODE_ENV is managed by Next.js and must NOT be set here.
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider API Keys
# -----------------------------------------------------------------------------

# Required. Powers /api/define, /api/ai-analyzer and the google models in
# /api/chat. The app fails to start without it.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Enables the groq models in /api/chat.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Enables the mistral models in /api/chat.
# Get one at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Optional. pino log level: debug | info | warn | error
# Defaults to "debug" in development and "info" in production.
# LOG_LEVEL=info

# Optional. Set to any non-empty value to skip env validation.
# Only needed for CI or Docker builds where secrets are unavailable.
# SKIP_ENV_VALIDATION=1
