{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "content:build": {
      "inputs": ["content/**", "velite.config.ts", "src/lib/mdx/**"],
      "outputs": [".velite/**", "public/static/**"]
    },
    "build": {
      "dependsOn": ["^build", "content:build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "GEMINI_API_KEY",
        "GROQ_API_KEY",
        "LOG_LEVEL",
        "MISTRAL_API_KEY",
        "NODE_ENV",
        "NEXT_RUNTIME",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "check-types": {
      "dependsOn": ["content:build"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "env": [
        "GEMINI_API_KEY",
        "GROQ_API_KEY",
        "LOG_LEVEL",
        "MISTRAL_API_KEY",
        "NODE_ENV",
        "NEXT_RUNTIME"
      ]
    },
    "lint": {
      "outputs": [],
      "env": ["LOG_LEVEL", "NODE_ENV", "SKIP_ENV_VALIDATION"]
    },
    "check": {
      "dependsOn": ["lint", "check-types"],
      "outputs": []
    }
  }
}
